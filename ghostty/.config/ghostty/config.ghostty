# Window
window-width = 115
window-height = 30
window-decoration = auto
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.3
background-blur = true

# Font
font-family = "MapleMono NF"
font-size = 12

# Terminal
command = /usr/bin/fish

# Cursor (Alacritty's "Beam" maps to Ghostty's "bar")
cursor-style = bar
cursor-style-blink = true

# Theme
theme = lavi.conf

