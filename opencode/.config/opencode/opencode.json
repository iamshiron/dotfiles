{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "agent": {
        "explore": {
            "mode": "subagent",
            "model": "zai-coding-plan/glm-4.7"
        },
        "general": {
            "mode": "subagent",
            "model": "zai-coding-plan/glm-5.3"
        },
        "title": {
            "model": "openai/gpt-5.6-luna"
        },
        "compaction": {
            "model": "zai-coding-plan/glm-5-turbo"
        }
    },
    "mcp": {
        "heroui-native": {
            "type": "local",
            "command": [
                "pnpx",
                "@heroui/native-mcp@latest"
            ],
            "enabled": false
        },
        "obsidian": {
            "type": "local",
            "command": [
                "pnpx",
                "@bitbonsai/mcpvault@latest",
                "/home/shiron/Notes/Notes"
            ],
            "enabled": false
        },
        "rider": {
            "type": "remote",
            "url": "http://127.0.0.1:64342/sse",
            "enabled": false
        },
        "shadcn": {
            "type": "local",
            "command": [
                "pnpx",
                "shadcn@latest",
                "mcp"
            ],
            "enabled": false
        },
        "playwright": {
            "type": "local",
            "command": [
                "pnpx",
                "@playwright/mcp@latest"
            ],
            "enabled": false
        },
        "avalonia": {
            "type": "local",
            "command": [
                "dotnet",
                "run",
                "--project",
                "/home/shiron/MCPServers/AvaloniaUI.MCP/src/AvaloniaUI.MCP/AvaloniaUI.MCP.csproj"
            ],
            "enabled": false
        }
    }
}